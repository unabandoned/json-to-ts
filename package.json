{
  "name": "@unabandoned/json-to-ts",
  "version": "2.1.0",
  "description": "Convert json object to typescript interfaces",
  "keywords": [
    "typescript",
    "ts",
    "convert",
    "json",
    "util",
    "lib",
    "types"
  ],
  "types": "build/src/index.d.ts",
  "main": "build/src/index.js",
  "scripts": {
    "build": "rm -rf ./build && tsc",
    "test": "npm run build && node --test build/test/*.spec.js test/js-integration/index.js",
    "prepublishOnly": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "author": "https://github.com/mariusalch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/json-to-ts.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/json-to-ts/issues"
  },
  "license": "ISC",
  "dependencies": {
    "hash.js": "^1.1.7",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.5",
    "@types/pluralize": "0.0.33",
    "typescript": "6.0.3"
  },
  "homepage": "https://github.com/unabandoned/json-to-ts#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "build/src/"
  ]
}
